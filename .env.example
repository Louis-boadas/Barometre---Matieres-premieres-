# ============================================================
#  Baromètre Matières Premières — Configuration
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- SQL Server ---
SQL_SERVER=<NOM_OU_IP_DU_SERVEUR>
SQL_DATABASE=barometre
SQL_USERNAME=barometre
SQL_PASSWORD=<MOT_DE_PASSE>

# --- Usine Nouvelle API ---
# Token Bearer JWT (expire périodiquement — voir README pour le renouveler)
UN_BEARER_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...

# Cookie de session (valeur de "usinenouvellePROD")
UN_SESSION_COOKIE=0r6e0rgf1i1q735edeaf5cs5m9...
